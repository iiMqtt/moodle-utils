{
  "manifest_version": 3,
  "name": "Moodle Utils",
  "version": "2.3.1",
  "description": "Keeps UNSW Moodle alive, restores sessions, removes feedback nags, highlights changes, and organises tabs.",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "https://moodle.telt.unsw.edu.au/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Moodle Utils",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moodle.telt.unsw.edu.au/*"
      ],
      "js": [
        "feedback-popup-blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://moodle.telt.unsw.edu.au/*"
      ],
      "js": [
        "tab-manager-core.js",
        "course-tab-manager.js",
        "change-detector-core.js",
        "changed-since-last-visit.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://moodle.telt.unsw.edu.au/*"
      ],
      "js": [
        "keepalive.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://moodle.telt.unsw.edu.au/mod/lti/launch.php*",
        "https://moodle.telt.unsw.edu.au/mod/lti/view.php*"
      ],
      "js": [
        "lti-autoclose.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png"
      ],
      "matches": [
        "https://moodle.telt.unsw.edu.au/*"
      ]
    }
  ]
}
